{
	"name": "haulout-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"sync": "node ../scripts/sync-static.mjs",
		"dev": "node ../scripts/site-dev.mjs",
		"build": "pnpm sync && filepress build",
		"preview": "filepress preview",
		"check": "filepress check",
		"ship": "pnpm build && wrangler pages deploy build --project-name=haulout",
		"deploy": "pnpm ship"
	},
	"devDependencies": {
		"getfilepress": "^0.1.38",
		"wrangler": "^4.28.0"
	},
	"pnpm": {
		"overrides": {
			"cookie@<0.7.0": "0.7.2",
			"sharp": "0.35.4"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"getfilepress",
			"workerd"
		]
	}
}
